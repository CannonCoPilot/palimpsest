  "book_title": ["THE BOOKE OF", "PSALMES"],
  "chapter_heading": "PSALME I.",
  "argument": {
    "role": "argument",
    "text": "The Royal prophet Dauid placed this Pſalme as a Preface to the reſt, conteyning, 1 true happines, which conſiſteth in flying ſinnes, and ſeruing God. 3. The good doe proſper, 5. not the Wicked: 6. as wil appeare in the end of this world.",
    "marginal_gloss": "The right maner of ſeruing God. The 7. key."
  },
  "verses_on_page": ["1:1", "1:2", "1:3", "1:4", "1:5", "1:6", "1:7"],
  "body": [
    { "line_index": 0, "verse": "1:1", "verse_number_printed": "1", "dropcap": "B", "text": "BLESSED is the man, that hath not gone in", "ref_letters_present": ["a", "b"] },
    { "line_index": 1, "verse": "1:1", "text": "the counſel of the impious, & hath not ſtoode" },
    { "line_index": 2, "verse": "1:1", "text": "in the way of ſinners, and hath not ſitte in the", "ref_letters_present": ["c", "d"] },
    { "line_index": 3, "verse": "1:1", "text": "chayre of peſtilence:" },
    { "line_index": 4, "verse": "1:2", "verse_number_printed": "2", "verse_marker": "†", "text": "† But his wil is in the way of our Lord, and in his law he", "ref_letters_present": ["e"] },
    { "line_index": 5, "verse": "1:2", "text": "wil meditate day and night." },
    { "line_index": 6, "verse": "1:3", "verse_number_printed": "3", "verse_marker": "†", "text": "† And he ſhal be as a tree, that is planted nigh to the ſtreames", "ref_letters_present": ["f"] },
    { "line_index": 7, "verse": "1:3", "text": "of waters, which ſhal geue his fruite in his time:" },
    { "line_index": 8, "verse": "1:4", "verse_number_printed": "4", "verse_marker": "†", "text": "† And his leafe ſhal not fal: and al things whatſoeuer he", "ref_letters_present": ["g", "h"] },
    { "line_index": 9, "verse": "1:4", "text": "ſhal doe, ſhal proſper." },
    { "line_index": 10, "verse": "1:5", "verse_number_printed": "5", "verse_marker": "†", "text": "† The impious not ſo: but as duſt, which the winde driueth", "ref_letters_present": ["i"] },
    { "line_index": 11, "verse": "1:5", "text": "from the face of the earth." },
    { "line_index": 12, "verse": "1:6", "verse_number_printed": "6", "verse_marker": "†", "text": "† Therfore the impious ſhal not riſe againe in iudgement:", "ref_letters_present": ["k"] },
    { "line_index": 13, "verse": "1:6", "text": "nor ſinners in the counſel of the iuſt", "ref_letters_present": ["l"] },
    { "line_index": 14, "verse": "1:7", "verse_number_printed": "7", "verse_marker": "†", "text": "† For our Lord knoweth the way of the iuſt, and the way of", "ref_letters_present": ["m"] },
    { "line_index": 15, "verse": "1:7", "text": "the impious ſhal perish.", "ref_letters_present": ["n"] }
  ],
  "apparatus": [
    { "role": "annotation", "ref_letter": "a", "anchor_verse": "1:1", "text": "He is in the right way to eternal felicitie." },
    { "role": "annotation", "ref_letter": "b", "anchor_verse": "1:1", "text": "not conſented to euil ſuggeſtions." },
    { "role": "annotation", "ref_letter": "c", "anchor_verse": "1:1", "text": "not continued in ſinne." },
    { "role": "annotation", "ref_letter": "d", "anchor_verse": "1:1", "text": "not finally perſiſted in Wicked life." },
    { "role": "annotation", "ref_letter": "e", "anchor_verse": "1:2", "text": "He is wholly occupied & delighted in keeping Gods commandments." },
    { "role": "annotation", "ref_letter": "f", "anchor_verse": "1:3", "text": "To him that vſeth Gods grace wel, more grace is continually geuen." },
    { "role": "annotation", "ref_letter": "g", "anchor_verse": "1:4", "text": "Through ſuch grace he ſhal perſeuer." },
    { "role": "annotation", "ref_letter": "h", "anchor_verse": "1:4", "text": "al things worke to the good of them that loue God ſincerely." },
    { "role": "annotation", "ref_letter": "i", "anchor_verse": "1:5", "text": "The Wicked are carried with euery light tentation." },
    { "role": "annotation", "ref_letter": "k", "anchor_verse": "1:6", "text": "Al riſing at the laſt day, the wicked ſhal not riſe with hope nor comforth, but in deſolation." },
    { "role": "annotation", "ref_letter": "l", "anchor_verse": "1:6", "text": "the happie congregation of the bleſſed." },
    { "role": "annotation", "ref_letter": "m", "anchor_verse": "1:7", "text": "approueth & rewardeth." },
    { "role": "annotation", "ref_letter": "n", "anchor_verse": "1:7", "text": "in eternal damnation." }
  ],
