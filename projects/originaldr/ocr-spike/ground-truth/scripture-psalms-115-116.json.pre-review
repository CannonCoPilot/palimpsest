    { "line_index": 4, "verse": "115:4", "text": "the name of our Lord." },
    { "line_index": 5, "verse": "115:5", "verse_number_printed": "5", "verse_marker": "†", "text": "5. † I wil i render my vowes to our Lord k before al his", "ref_letters_present": ["i","k"] },
    { "line_index": 6, "verse": "115:6", "verse_number_printed": "6", "verse_marker": "†", "text": "6. people : † l precious in the ſight of our Lord is the death of", "ref_letters_present": ["l"] },
    { "line_index": 7, "verse": "115:6", "text": "his Sainctes." },
    { "line_index": 8, "verse": "115:7", "verse_number_printed": "7", "verse_marker": "†", "text": "7. † O Lord becauſe m I am thy ſeruant : I am thy ſeruant, and", "ref_letters_present": ["m"] },
    { "line_index": 9, "verse": "115:7", "text": "n the ſonne of thy handmaide.", "ref_letters_present": ["n"] },
    { "line_index": 10, "verse": "115:8", "verse_number_printed": "8", "verse_marker": "†", "text": "8. Thou haſt o broken my bondes : † I wil ſacrifice to thee the", "ref_letters_present": ["o"] },
    { "line_index": 11, "verse": "115:8", "text": "hoaſt of praiſe, and I wil inuocate the name of our Lord." },
