    { "line_index": 0, "verse": "115:2", "verse_number_printed": "2", "verse_marker": "†", "text": "2. † I ſaid d in mine exceſſe : Euerie man is a lyer.", "ref_letters_present": ["d"] },
    { "line_index": 1, "verse": "115:3", "verse_number_printed": "3", "verse_marker": "†", "text": "3. † What e ſhal I render to our Lord, for al things that he", "ref_letters_present": ["e"] },
    { "line_index": 2, "verse": "115:3", "text": "f hath rendred to me?", "ref_letters_present": ["f"] },
