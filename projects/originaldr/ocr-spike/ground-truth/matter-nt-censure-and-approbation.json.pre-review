    {"line_index": 10, "role": "latin", "text": "rum probitatem promouere: ex ipſorum fide cen-", "line_end_hyphen": true},
    {"line_index": 11, "role": "latin", "text": "ſemus iſta vtiliter excudi & publicari poſſe."},
