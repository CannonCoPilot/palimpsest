    {"line_index": 13, "role": "latin", "block": "signatory", "text": "Eccleſiæ Rhemenſis, Iuris Canonici Doctor, Archiepiſcopatus Rhemenſis"},
    {"line_index": 14, "role": "latin", "block": "signatory", "text": "generalis Vicarius."},
    {"line_index": 15, "role": "latin", "block": "signatory", "text": "HVBERTVS MORVS, Rhemenſis Eccleſiæ Decanus, & Eccleſiaſtes,"},
