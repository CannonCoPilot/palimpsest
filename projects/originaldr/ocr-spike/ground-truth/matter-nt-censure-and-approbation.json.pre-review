    {"line_index": 17, "role": "latin", "block": "signatory", "text": "IOANNES LE BESGVE, Canonicus Rhemenſis, Doctor Theologus,"},
    {"line_index": 18, "role": "latin", "block": "signatory", "text": "& Cancellarius Academiæ Rhemenſis."},
