 },
 "stack": [
  {
   "id": "V0",
   "name": "SOURCE INVENTORY",
   "modules": "witness_inventory.py · master-source-list.json",
   "fault": "Which physical volumes exist and which tome each holds. FAULT: a book attested by a volume that cannot contain it (an NT-only witness claiming Genesis), or an admitted volume that is a duplicate rendering."
  },
  {
   "id": "V1",
   "name": "PAGE ADDRESSING",
   "modules": "page_address.py (monotone DP) · page_address_eval.py → .page-address-*.json",
   "fault": "page → (book, chapter). FAULT: a chapter with no page at all; a page addressed to the wrong chapter. The DP is MONOTONE, so a single false heading does not mis-label one page — it makes every chapter between the true and false position unreachable (defect #9)."
  },
  {
   "id": "V2",
   "name": "TOME MAP",
   "modules": "build_tome_map_v2.py → tome-map-v2.json",
   "fault": "The derived per-volume coverage claim. FAULT: divergence from V1. It is DERIVED from addressing, so it can never be fed back as a prior — that would be a self-fulfilling loop (see `tome_prior`)."
  },
  {
   "id": "V3",
   "name": "PINNING / BODY ISOLATION",
   "modules": "pin_carry_chain · corpus_localize._line_range · verse_geom.build_body_tokmap",
   "fault": "Which lines of a page are body, and which chapter owns them. FAULT: a chapter's line range truncated (defect #8) or over-offered; marginal-column apparatus concatenated INTO a body line by the line builder, so it cannot be separated downstream by role."
  },
  {
   "id": "V4",
   "name": "VERSE LOCALIZATION",
   "modules": "verse_locate.best_spans (walk ⊕ align hybrid) · verse_seg.segment",
   "fault": "chapter body → per-verse spans. FAULT: no span for a verse present on the page (a MISS); a span that stops short or swallows its neighbour."
  },
  {
   "id": "V5",
   "name": "RECOGNITION",
   "modules": "reocr_core (kraken base / R1 / R2 fine-tuned) · r3_route (olmOCR)",
   "fault": "Glyph accuracy on the span's pixels. FAULT: substituted tokens. This is the ONLY layer a better recognizer can fix, which is why everything above it must be excluded first."
  },
  {
   "id": "V6",
   "name": "REFERENCE",
   "modules": "s_dismas (archaic, preeminent) · odr_com (archaic backfill) · janvier/sabates_a (modern grid)",
   "fault": "What the verse is compared against, and the versification grid it is cut on. FAULT: a locus the reference does not carry; a versification offset (the Psalm superscription shift)."
  },
  {
   "id": "V7",
   "name": "GATING / SCORING",
   "modules": "qc_audit (archaic_id, modern_id, ARCHAIC_VALID_FLOOR) · xsrc_gate",
   "fault": "archaic-preeminent identity scoring and the ≥0.90 bar. FAULT: a metric that consults a set the label helped build (defect #7), or any rule that converts a below-bar unit into an accepted one."
  },
  {
   "id": "V8",
   "name": "REPORTING / VERSIONING",
   "modules": "build_reocr_report.py · version_compare.py",
   "fault": "What is published and how versions are compared. FAULT: a stale or circular figure persisted where a later reader will quote it."
  }
 ],
 "kinds": {
  "A": {
   "label": "EXTRA tokens",
