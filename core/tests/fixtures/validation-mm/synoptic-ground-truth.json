  "metadata": {
    "compiled": "2026-06-30",
    "description": "Pericope-level Matthew<->Mark ground truth for the standing validation collection. Oracle for cross-text similarity detection: shared_pericopes are true-positives (should surface Mt<->Mk similarity, off-diagonal in an alignment); matthew_unique + mark_unique are true-negatives (should NOT match cross-text).",
    "primary_sources": [
      "Aland, Synopsis Quattuor Evangeliorum (13th ed.), via bible-researcher.com/parallels.html",
      "Stephen C. Carlson, Parallel Synoptic Table, hypotyposeis.org (2004, based on Aland)",
      "Supporting: Wikipedia (Synoptic Gospels; Blind man of Bethsaida; Deaf-mute of Decapolis; Naked fugitive)"
    ],
    "versification": "KJV/RSV-standard (Nestle-Aland chapter:verse); applies to Douay-Rheims and 1599 Geneva NT gospels without shift",
    "tradition_definition": {
      "triple": "present in Matthew, Mark, and Luke",
      "double": "present in Matthew and Mark but NOT Luke"
    },
    "usage_for_validation": {
      "TP_set": "shared_pericopes (regardless of triple/double) -- Mt and Mk both contain the passage; a correct cross-text analysis links them",
      "TN_set": "matthew_unique UNION mark_unique -- no cross-gospel counterpart; a correct analysis leaves them unlinked",
      "note": "Tradition (triple/double) is retained for scholarly completeness but is orthogonal to the Mt<->Mk TP/TN judgement. Confidence flags 'medium' mark boundary-debated or partial-echo pericopes; weight them lower when scoring recall/precision."
    }
  },
